---
import { Code } from '@astrojs/starlight/components';

interface Props {
  repo?: string;
  branch?: string;
  file: string;
  lang?: string;
  title?: string;
}

const {
  repo = 'teamwork-fahad/DSA-Programs-in-C',
  branch = 'main',
  file,
  lang = 'c',
  title,
} = Astro.props;

const rawUrl = `https://raw.githubusercontent.com/${repo}/${branch}/${file}`;
const githubUrl = `https://github.com/${repo}/blob/${branch}/${file}`;
const displayTitle = title || file;

let code = '';
let fetchFailed = false;

try {
  const response = await fetch(rawUrl);
  if (response.ok) {
    code = await response.text();
  } else {
    fetchFailed = true;
  }
} catch (error) {
  fetchFailed = true;
}
---

<div class="github-code-wrapper">
  {code ? (
    <Code code={code} lang={lang} title={displayTitle} />
  ) : (
    <div class="github-code-error">
      <p>⚠️ Could not fetch source code from GitHub.</p>
      <a href={githubUrl} target="_blank" rel="noopener noreferrer">View {file} on GitHub</a>
    </div>
  )}
  <div class="github-code-footer">
    <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="github-source-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
      </svg>
      <span>View Source on GitHub ({file})</span>
    </a>
  </div>
</div>

<style>
  .github-code-wrapper {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .github-code-footer {
    margin-top: 0.5rem;
    display: flex;
    justify-content: flex-end;
  }
  .github-source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border-radius: 0.375rem;
    background-color: var(--sl-color-bg-inline-code, rgba(255, 255, 255, 0.05));
    color: var(--sl-color-text-accent, #3b82f6);
    border: 1px solid var(--sl-color-gray-5, rgba(255, 255, 255, 0.15));
    font-size: var(--sl-text-xs, 0.8125rem);
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .github-source-link:hover {
    background-color: var(--sl-color-text-accent, #3b82f6);
    color: #ffffff;
    border-color: var(--sl-color-text-accent, #3b82f6);
  }
  .github-code-error {
    padding: 1rem;
    border-radius: 0.375rem;
    background-color: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #f87171;
  }
</style>
