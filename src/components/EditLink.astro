---
import type { Props } from '@astrojs/starlight/props';

const props = Astro.props;

// Determine if we are running in local dev mode or production
const isDev = import.meta.env.DEV || process.env.NODE_ENV === 'development';

const hasKeystaticCookie = 
  Astro.cookies.has('keystatic-gh-access-token') || 
  Astro.cookies.has('keystatic-session') ||
  Astro.cookies.has('keystatic-state');

const showEditButton = isDev || hasKeystaticCookie;

// Local dev mode uses /keystatic/collection/... (NO branch prefix)
// GitHub production mode uses /keystatic/branch/master/collection/...
const keystaticPrefix = isDev ? '/keystatic/collection' : '/keystatic/branch/master/collection';

// Get pathname from Astro URL or props
let pathname = (props.entry?.id || Astro.url.pathname || '').replace(/^\/|\/$/g, '');
if (pathname.endsWith('.md')) pathname = pathname.slice(0, -3);
if (pathname.endsWith('.mdx')) pathname = pathname.slice(0, -4);
if (!pathname) pathname = 'index';

const parts = pathname.split('/');
const firstSegment = parts[0];

const knownSubjectCollections = ['dsa', 'sql', 'python', 'angular', 'maths', 'foc', 'oop'];

let collectionName = 'markdownTutorials';
let relativeSlugParts = parts;

if (knownSubjectCollections.includes(firstSegment) && parts.length > 1) {
  collectionName = firstSegment;
  relativeSlugParts = parts.slice(1);
} else if (knownSubjectCollections.includes(firstSegment)) {
  collectionName = firstSegment;
  relativeSlugParts = parts;
}

const encodedSlug = relativeSlugParts.map(encodeURIComponent).join('/');
const editUrl = `${keystaticPrefix}/${collectionName}/item/${encodedSlug}`;
---

{editUrl && showEditButton && (
  <div class="keystatic-edit-wrapper sl-flex">
    <a href={editUrl} class="keystatic-edit-btn sl-flex" target="_blank" rel="noopener noreferrer">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 20h9"></path>
        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
      </svg>
      <span>EDIT IN KEYSTATIC TEST</span>
    </a>
  </div>
)}

<style>
  .keystatic-edit-wrapper {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  .keystatic-edit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border-radius: 0.375rem;
    background-color: var(--sl-color-bg-inline-code, rgba(59, 130, 246, 0.1));
    color: var(--sl-color-text-accent, #3b82f6);
    border: 1px solid var(--sl-color-text-accent, rgba(59, 130, 246, 0.3));
    font-size: var(--sl-text-sm, 0.875rem);
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .keystatic-edit-btn:hover {
    background-color: var(--sl-color-text-accent, #3b82f6);
    color: #ffffff;
    border-color: var(--sl-color-text-accent, #3b82f6);
  }
</style>
