---
const initialSubjects = [
  { id: 'python', name: 'Python', color: '#2f7d6d', concepts: 14, tasks: 14 },
  { id: 'sql', name: 'SQL', color: '#c15f3c', concepts: 6, tasks: 171 },
  { id: 'dsa', name: 'Data Structures and Algorithms', color: '#5475a6', concepts: 6, tasks: 0 },
  { id: 'maths', name: 'Mathematics', color: '#bd8a38', concepts: 5, tasks: 0 },
  { id: 'css', name: 'CSS', color: '#3c83a3', concepts: 1, tasks: 0 },
  { id: 'html', name: 'HTML', color: '#d36b43', concepts: 1, tasks: 0 },
  { id: 'javascript', name: 'JavaScript', color: '#b49335', concepts: 1, tasks: 0 },
  { id: 'foc', name: 'Fundamentals of Computer', color: '#8066a6', concepts: 5, tasks: 0 },
  { id: 'oop', name: 'Object-Oriented Programming', color: '#4f8b77', concepts: 4, tasks: 0 },
];

const initialItems = [
  { id: 1, type: 'Task', label: 'DHP', title: 'Student database with SQLite', subject: 'Python', status: 'Published', updated: 'Today' },
  { id: 2, type: 'Task', label: 'SQL Exercise II', title: 'SQL Tasks - Exercise II', subject: 'SQL', status: 'Published', updated: 'Today' },
  { id: 3, type: 'Concept', label: 'File Handling', title: 'Working with CSV files', subject: 'Python', status: 'Published', updated: 'Yesterday' },
  { id: 4, type: 'Concept', label: 'Basics', title: 'Simple SQL queries', subject: 'SQL', status: 'Published', updated: 'Yesterday' },
  { id: 5, type: 'Concept', label: 'Linear', title: 'Linear data structures', subject: 'Data Structures and Algorithms', status: 'Draft', updated: '3 days ago' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Admin | AppXwinD Docs</title>
    <meta name="description" content="Manage AppXwinD Docs subjects, concepts, and tasks." />
    <style is:global>
      @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
      :root { --ink:#23302d; --muted:#73807a; --line:#e2e8e3; --paper:#f7f9f5; --teal:#2f7d6d; --coral:#c15f3c; }
      * { box-sizing:border-box; } body { margin:0; color:var(--ink); background:var(--paper); font-family:'DM Sans',sans-serif; } button,input,select,textarea { font:inherit; } button { cursor:pointer; }
      .lock-screen { position:fixed; inset:0; z-index:10; display:grid; place-items:center; padding:24px; background:#20302d; background-image:linear-gradient(135deg,#20302d 0%,#2f5148 100%); } .lock-screen.unlocked { display:none; } .lock-card { width:min(410px,100%); padding:38px; background:#fff; border-radius:8px; box-shadow:0 24px 80px #13231f66; } .lock-mark { width:43px; height:43px; display:grid; place-items:center; margin-bottom:28px; border-radius:50%; background:var(--coral); color:white; font:700 20px 'Space Grotesk',sans-serif; } .eyebrow { color:#91a89e; font-size:10px; font-weight:700; letter-spacing:1.5px; } .warm { color:var(--coral); } .lock-card h1 { margin:8px 0; font:600 30px 'Space Grotesk',sans-serif; } .lock-copy { color:var(--muted); line-height:1.55; margin:0 0 26px; } #access-form { display:grid; gap:8px; } #access-form label { color:#586861; font-size:12px; font-weight:600; } #access-form input { letter-spacing:7px; font-size:22px; text-align:center; } .access-error { display:none; margin:2px 0 4px; color:#b14e3b; font-size:12px; } .access-error.visible { display:block; } .primary-btn,.outline-btn { border:1px solid var(--line); border-radius:5px; padding:10px 14px; font-weight:600; font-size:13px; } .primary-btn { background:var(--teal); color:#fff; border-color:var(--teal); } .lock-card .primary-btn { margin-top:8px; padding:12px; } .lock-card .back-link { display:block; margin-top:24px; border-top:1px solid var(--line); padding-top:18px; color:var(--coral); font-size:13px; text-decoration:none; }
      .shell { min-height:100vh; display:flex; } .sidebar { width:250px; padding:30px 18px 22px; background:#20302d; color:#d8e3dd; display:flex; flex-direction:column; } .main { flex:1; max-width:1400px; padding:34px 5.5vw 70px; } .topbar { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; border-bottom:1px solid var(--line); padding-bottom:27px; } .content-table { background:#fff; border:1px solid var(--line); overflow-x:auto; } .table-head,.table-row { min-width:850px; display:grid; grid-template-columns:2fr .7fr 1.05fr 1.25fr .85fr .85fr 110px; align-items:center; gap:14px; padding:14px 18px; } .table-head { color:#89958f; text-transform:uppercase; letter-spacing:1px; font-size:10px; font-weight:700; border-bottom:1px solid var(--line); } .table-row { min-height:61px; border-bottom:1px solid #edf1ee; font-size:13px; } .label-chip { width:max-content; color:#9a5c42; background:#faeee8; border-radius:4px; padding:4px 7px; font-size:11px; font-weight:600; }
      h1,h2,h3,p { margin:0; } h1 { font:600 30px 'Space Grotesk',sans-serif; letter-spacing:-.8px; margin-top:6px; } h2 { font:600 24px 'Space Grotesk',sans-serif; letter-spacing:-.5px; } .eyebrow { margin-bottom:7px; } .top-actions,.filters,.form-row,.dialog-actions { display:flex; align-items:center; gap:10px; } .section-heading { display:flex; justify-content:space-between; align-items:end; gap:20px; margin-bottom:18px; } .section-heading h2 { margin-top:6px; } .page-heading { align-items:center; } .subject-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:18px; } .subject-card { background:#fff; border:1px solid var(--line); border-top:4px solid var(--subject-color); border-radius:8px; padding:20px; min-height:210px; box-shadow:0 8px 24px #23302d0a; transition:transform .2s ease,box-shadow .2s ease; } .subject-card:hover { transform:translateY(-3px); box-shadow:0 12px 28px #23302d18; } .subject-top { display:flex; justify-content:space-between; min-height:12px; } .subject-swatch { display:block; width:12px; height:12px; border-radius:50%; background:var(--subject-color); box-shadow:0 0 0 5px color-mix(in srgb,var(--subject-color) 14%,transparent); } .subject-card h3 { font:600 18px 'Space Grotesk',sans-serif; line-height:1.2; margin:24px 0 16px; } .subject-meta { display:flex; justify-content:space-between; color:var(--muted); font-size:12px; gap:8px; } .subject-bar { background:#edf1ee; height:5px; margin-top:20px; border-radius:5px; overflow:hidden; } .subject-bar i { display:block; height:100%; background:var(--subject-color); border-radius:5px; } .card-actions { display:flex; align-items:center; gap:14px; justify-content:flex-start; padding-top:16px; } .card-actions button,.row-actions button { border:0; background:transparent; color:var(--coral); padding:0; font-size:12px; font-weight:600; } .view-toggle { display:flex; border:1px solid var(--line); border-radius:5px; overflow:hidden; background:#fff; } .view-btn { border:0; border-right:1px solid var(--line); background:#fff; color:var(--muted); padding:9px 12px; font-size:12px; font-weight:600; } .view-btn:last-child { border-right:0; } .view-btn.active { background:#e3eee8; color:var(--teal); } .subject-table { background:#fff; border:1px solid var(--line); overflow-x:auto; } .subject-table-head,.subject-table-row { min-width:520px; display:grid; grid-template-columns:2fr 1fr 1fr 160px; align-items:center; gap:14px; padding:15px 18px; } .subject-table-head { color:#89958f; text-transform:uppercase; letter-spacing:1px; font-size:10px; font-weight:700; border-bottom:1px solid var(--line); } .subject-table-row { min-height:62px; border-bottom:1px solid #edf1ee; font-size:13px; } .subject-table-row:last-child { border-bottom:0; } .subject-table-row strong { display:flex; align-items:center; gap:10px; } .subject-table-row strong i { width:9px; height:9px; border-radius:50%; }
      @media (max-width:850px) { .sidebar { width:72px; padding:22px 10px; } .brand { font-size:0; padding:0 10px 45px; } .brand:first-letter { font-size:22px; } .workspace-label,.nav-item:not(.active) { font-size:0; } .nav-item { text-align:center; padding:12px 5px; } .nav-icon { width:auto; font-size:18px; } .back-link,.admin-user div:not(.avatar) { display:none; } .admin-user { justify-content:center; padding-left:0; padding-right:0; } .main { padding:25px 20px 50px; } .topbar { display:block; } .top-actions { margin-top:18px; flex-wrap:wrap; } .section-heading.page-heading { display:block; } .filters { margin-top:18px; flex-wrap:wrap; } }
    </style>
  </head>
  <body>
    <section class="lock-screen" id="lock-screen">
      <div class="lock-card">
        <div class="lock-mark">A</div>
        <p class="eyebrow warm">PRIVATE WORKSPACE</p>
        <h1>Admin access</h1>
        <p class="lock-copy">Enter your access code to manage subjects, concepts, and tasks.</p>
        <form id="access-form">
          <label for="access-code">Access code</label>
          <input id="access-code" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="off" required placeholder="••••" />
          <p class="access-error" id="access-error">Incorrect code. Try again.</p>
          <button class="primary-btn" type="submit">Unlock admin panel</button>
        </form>
        <a class="back-link" href="/">← Back to documentation</a>
      </div>
    </section>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href="/">AppXwinD <span>Docs</span></a>
        <div class="workspace-label">WORKSPACE</div>
        <nav>
          <button class="nav-item active" data-view="overview"><span class="nav-icon">◈</span> Overview</button>
          <button class="nav-item" data-view="content"><span class="nav-icon">▤</span> Content</button>
          <button class="nav-item" data-view="subjects"><span class="nav-icon">◫</span> Subjects</button>
        </nav>
        <div class="sidebar-bottom">
          <a href="/" class="back-link">← View documentation</a>
          <div class="admin-user"><div class="avatar">A</div><div><strong>Admin</strong><small>Content manager</small></div></div>
        </div>
      </aside>

      <main class="main">
        <header class="topbar">
          <div><p class="eyebrow">CONTENT WORKSPACE</p><h1 id="page-title">Overview</h1></div>
          <div class="top-actions"><span class="saved"><i></i> All changes saved</span><button class="outline-btn" id="export-btn">Export data</button><button class="primary-btn" id="new-btn">＋ New content</button></div>
        </header>

        <section class="view active-view" id="overview-view">
          <div class="welcome"><div><p class="eyebrow warm">A CLEARER WAY TO CURATE</p><h2>Your docs, in one place.</h2><p>Keep subjects organized and practical learning content easy to find.</p></div><div class="welcome-mark">✦</div></div>
          <div class="stat-grid"><article class="stat-card"><span>Total subjects</span><strong id="subject-count">4</strong><small>Across your workspace</small></article><article class="stat-card"><span>Published content</span><strong id="published-count">4</strong><small>Ready for learners</small></article><article class="stat-card"><span>Drafts</span><strong id="draft-count">1</strong><small>Waiting for review</small></article><article class="stat-card accent"><span>Tasks collected</span><strong id="task-count">185</strong><small>Practical work and exercises</small></article></div>
          <div class="section-heading"><div><p class="eyebrow">RECENT ACTIVITY</p><h2>Latest content</h2></div><button class="text-btn" data-view-link="content">View all content →</button></div>
          <div class="content-table" id="recent-table"></div>
        </section>

        <section class="view" id="content-view">
          <div class="section-heading page-heading"><div><p class="eyebrow">LIBRARY</p><h2>All content</h2></div><div class="filters"><input id="search" type="search" placeholder="Search content..." /><select id="type-filter"><option value="All">All types</option><option value="Concept">Concepts</option><option value="Task">Tasks</option></select><select id="subject-filter"><option value="All">All subjects</option></select><div class="view-toggle" role="group" aria-label="Content view"><button class="view-btn active" data-content-view="grid">Grid</button><button class="view-btn" data-content-view="table">Table</button></div></div></div>
          <div class="content-grid" id="content-grid"></div>
          <div class="content-table" id="content-table"></div>
        </section>

        <section class="view" id="subjects-view">
          <div class="section-heading page-heading"><div><p class="eyebrow">STRUCTURE</p><h2>Subjects</h2></div><div class="filters"><div class="view-toggle" role="group" aria-label="Subject view"><button class="view-btn active" data-subject-view="grid">Grid</button><button class="view-btn" data-subject-view="table">Table</button></div><button class="primary-btn" id="subject-new-btn">＋ Add subject</button></div></div>
          <div class="subject-grid" id="subject-grid"></div>
          <div class="subject-table" id="subject-table"></div>
        </section>
      </main>
    </div>

    <dialog id="content-dialog"><form method="dialog" id="content-form"><div class="dialog-head"><div><p class="eyebrow">CONTENT ENTRY</p><h2 id="dialog-title">New content</h2></div><button class="close-btn" value="cancel" aria-label="Close">×</button></div><label>Title<input name="title" required placeholder="e.g. Introduction to joins" /></label><div class="form-row"><label>Type<select name="type"><option>Concept</option><option>Task</option></select></label><label>Subject<select name="subject" id="form-subject"></select></label></div><label>Label / topic<input name="label" required placeholder="e.g. DHP, Basics, Exercise II" /></label><label>Status<select name="status"><option>Published</option><option>Draft</option></select></label><label>Short description<textarea name="description" rows="4" placeholder="What should learners learn here?"></textarea></label><div class="dialog-actions"><button class="outline-btn" value="cancel">Cancel</button><button class="primary-btn" value="default">Save content</button></div></form></dialog>

    <dialog id="subject-dialog"><form method="dialog" id="subject-form"><div class="dialog-head"><div><p class="eyebrow">SUBJECT</p><h2>New subject</h2></div><button class="close-btn" value="cancel" aria-label="Close">×</button></div><label>Subject name<input name="name" required placeholder="e.g. Web Development" /></label><label>Accent color<input name="color" type="color" value="#2f7d6d" /></label><div class="dialog-actions"><button class="outline-btn" value="cancel">Cancel</button><button class="primary-btn" value="default">Add subject</button></div></form></dialog>

    <script define:vars={{ initialSubjects, initialItems }}>
      const lockScreen = document.querySelector('#lock-screen');
      const accessForm = document.querySelector('#access-form');
      const accessCode = document.querySelector('#access-code');
      const accessError = document.querySelector('#access-error');
      if (sessionStorage.getItem('appxwind-admin-access') === 'granted') lockScreen.classList.add('unlocked');
      accessForm.addEventListener('submit', (event) => { event.preventDefault(); if (accessCode.value === '3242') { sessionStorage.setItem('appxwind-admin-access', 'granted'); lockScreen.classList.add('unlocked'); } else { accessError.classList.add('visible'); accessCode.value = ''; accessCode.focus(); } });
      const storedSubjects = JSON.parse(localStorage.getItem('appxwind-subjects') || '[]');
      const subjects = initialSubjects.map((subject) => storedSubjects.find((stored) => stored.id === subject.id) || subject);
      storedSubjects.filter((stored) => !subjects.some((subject) => subject.id === stored.id)).forEach((subject) => subjects.push(subject));
      const items = JSON.parse(localStorage.getItem('appxwind-content') || JSON.stringify(initialItems));
      let editingId = null;
      let editingSubjectId = null;
      const $ = (selector) => document.querySelector(selector);
      const save = () => { localStorage.setItem('appxwind-subjects', JSON.stringify(subjects)); localStorage.setItem('appxwind-content', JSON.stringify(items)); };
      const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char]));
      const subjectOptions = (select) => { select.innerHTML = subjects.map((subject) => `<option value="${escapeHtml(subject.name)}">${escapeHtml(subject.name)}</option>`).join(''); };
      const row = (item) => `<div class="table-row"><div class="item-title"><span class="type-dot ${item.type.toLowerCase()}"></span><strong>${escapeHtml(item.title)}</strong></div><span class="type-label">${item.type}</span><span class="label-chip">${escapeHtml(item.label || 'General')}</span><span>${escapeHtml(item.subject)}</span><span class="status ${item.status.toLowerCase()}">${item.status}</span><span class="muted">${item.updated}</span><div class="row-actions"><button data-edit="${item.id}" title="Edit">Edit</button><button data-delete="${item.id}" title="Delete">Delete</button></div></div>`;
      function render() {
        $('#recent-table').innerHTML = `<div class="table-head"><span>Title</span><span>Type</span><span>Label</span><span>Subject</span><span>Status</span><span>Updated</span><span></span></div>` + items.slice(0, 5).map(row).join('');
        const query = ($('#search')?.value || '').toLowerCase(); const type = $('#type-filter')?.value || 'All'; const subject = $('#subject-filter')?.value || 'All';
        const filtered = items.filter((item) => (!query || item.title.toLowerCase().includes(query)) && (type === 'All' || item.type === type) && (subject === 'All' || item.subject === subject));
        $('#content-table').innerHTML = `<div class="table-head"><span>Title</span><span>Type</span><span>Label</span><span>Subject</span><span>Status</span><span>Updated</span><span></span></div>` + (filtered.length ? filtered.map(row).join('') : '<div class="empty">No content matches your filters.</div>');
        $('#content-grid').innerHTML = filtered.length ? filtered.map((item) => `<article class="content-card"><div class="card-top"><span class="type-badge ${item.type.toLowerCase()}">${item.type}</span><span class="status ${item.status.toLowerCase()}">${item.status}</span></div><h3>${escapeHtml(item.title)}</h3><p class="card-label">${escapeHtml(item.label || 'General')}</p><div class="card-footer"><span>${escapeHtml(item.subject)}</span><span>${item.updated}</span></div><div class="card-actions"><button data-edit="${item.id}">Edit</button><button data-delete="${item.id}">Delete</button></div></article>`).join('') : '<div class="empty">No content matches your filters.</div>';
        $('#subject-grid').innerHTML = subjects.map((subject) => `<article class="subject-card" style="--subject-color:${subject.color}"><div class="subject-top"><span class="subject-swatch"></span></div><h3>${escapeHtml(subject.name)}</h3><div class="subject-meta"><span>${subject.concepts} concepts</span><span>${subject.tasks} tasks</span></div><div class="subject-bar"><i style="width:${Math.min(100, Math.max(12, subject.concepts * 6))}%"></i></div><div class="card-actions"><button data-subject-edit="${escapeHtml(subject.id)}">Edit</button><button data-subject-delete="${escapeHtml(subject.id)}">Delete</button></div></article>`).join('');
        $('#subject-table').innerHTML = `<div class="subject-table-head"><span>Subject</span><span>Concepts</span><span>Tasks</span><span></span></div>` + subjects.map((subject) => `<div class="subject-table-row"><strong><i style="background:${subject.color}"></i>${escapeHtml(subject.name)}</strong><span>${subject.concepts}</span><span>${subject.tasks}</span><div class="row-actions"><button data-subject-edit="${escapeHtml(subject.id)}">Edit</button><button data-subject-delete="${escapeHtml(subject.id)}">Delete</button></div></div>`).join('');
        $('#subject-count').textContent = subjects.length; $('#published-count').textContent = items.filter((item) => item.status === 'Published').length; $('#draft-count').textContent = items.filter((item) => item.status === 'Draft').length; $('#task-count').textContent = items.filter((item) => item.type === 'Task').reduce((total, item) => total + (item.subject === 'SQL' ? 171 : 14), 0);
        subjectOptions($('#subject-filter')); $('#subject-filter').insertAdjacentHTML('afterbegin', '<option value="All">All subjects</option>'); $('#subject-filter').value = subject;
        subjectOptions($('#form-subject'));
      }
      function showView(view) { document.querySelectorAll('.view').forEach((element) => element.classList.remove('active-view')); $(`#${view}-view`).classList.add('active-view'); document.querySelectorAll('.nav-item').forEach((element) => element.classList.toggle('active', element.dataset.view === view)); $('#page-title').textContent = view[0].toUpperCase() + view.slice(1); }
      function showContentView(view) { document.querySelector('#content-grid').style.display = view === 'grid' ? 'grid' : 'none'; document.querySelector('#content-table').style.display = view === 'table' ? 'block' : 'none'; document.querySelectorAll('[data-content-view]').forEach((button) => button.classList.toggle('active', button.dataset.contentView === view)); sessionStorage.setItem('appxwind-content-view', view); }
      function showSubjectView(view) { document.querySelector('#subject-grid').style.display = view === 'grid' ? 'grid' : 'none'; document.querySelector('#subject-table').style.display = view === 'table' ? 'block' : 'none'; document.querySelectorAll('[data-subject-view]').forEach((button) => button.classList.toggle('active', button.dataset.subjectView === view)); sessionStorage.setItem('appxwind-subject-view', view); }
      document.querySelectorAll('.nav-item').forEach((button) => button.addEventListener('click', () => showView(button.dataset.view)));
      document.querySelectorAll('[data-view-link]').forEach((button) => button.addEventListener('click', () => showView(button.dataset.viewLink)));
      document.querySelectorAll('[data-content-view]').forEach((button) => button.addEventListener('click', () => showContentView(button.dataset.contentView)));
      document.querySelectorAll('[data-subject-view]').forEach((button) => button.addEventListener('click', () => showSubjectView(button.dataset.subjectView)));
      ['search', 'type-filter', 'subject-filter'].forEach((id) => $(`#${id}`).addEventListener('input', render));
      $('#new-btn').addEventListener('click', () => { editingId = null; $('#dialog-title').textContent = 'New content'; $('#content-form').reset(); subjectOptions($('#form-subject')); $('#content-dialog').showModal(); });
      $('#subject-new-btn').addEventListener('click', () => { editingSubjectId = null; $('#subject-form').reset(); $('#subject-dialog h2').textContent = 'New subject'; $('#subject-dialog').showModal(); });
      document.addEventListener('click', (event) => { const edit = event.target.closest('[data-edit]'); const remove = event.target.closest('[data-delete]'); const subjectEdit = event.target.closest('[data-subject-edit]'); const subjectDelete = event.target.closest('[data-subject-delete]'); if (edit) { const item = items.find((entry) => entry.id === Number(edit.dataset.edit)); editingId = item.id; $('#dialog-title').textContent = 'Edit content'; $('#content-form').elements.title.value = item.title; $('#content-form').elements.type.value = item.type; $('#content-form').elements.label.value = item.label || 'General'; $('#content-form').elements.subject.value = item.subject; $('#content-form').elements.status.value = item.status; $('#content-dialog').showModal(); } if (remove) { const index = items.findIndex((entry) => entry.id === Number(remove.dataset.delete)); if (confirm('Delete this content item?')) { items.splice(index, 1); save(); render(); } } if (subjectEdit) { const subject = subjects.find((entry) => entry.id === subjectEdit.dataset.subjectEdit); editingSubjectId = subject.id; $('#subject-form').elements.name.value = subject.name; $('#subject-form').elements.color.value = subject.color; $('#subject-dialog h2').textContent = 'Edit subject'; $('#subject-dialog').showModal(); } if (subjectDelete && confirm('Delete this subject?')) { const index = subjects.findIndex((entry) => entry.id === subjectDelete.dataset.subjectDelete); subjects.splice(index, 1); save(); render(); } });
      $('#content-form').addEventListener('submit', (event) => { event.preventDefault(); const data = new FormData(event.currentTarget); const title = String(data.get('title')).trim(); const duplicate = items.find((item) => item.id !== editingId && item.title.trim().toLowerCase() === title.toLowerCase() && item.subject === data.get('subject')); if (duplicate) { alert('A content item with this title already exists in this subject.'); return; } const value = { id: editingId || Date.now(), type: data.get('type'), label: data.get('label'), title, subject: data.get('subject'), status: data.get('status'), updated: 'Just now' }; if (editingId) Object.assign(items.find((item) => item.id === editingId), value); else items.unshift(value); save(); render(); $('#content-dialog').close(); });
      $('#subject-form').addEventListener('submit', (event) => { event.preventDefault(); const data = new FormData(event.currentTarget); const value = { id: editingSubjectId || data.get('name').toLowerCase().replace(/\s+/g, '-'), name: data.get('name'), color: data.get('color'), concepts: editingSubjectId ? subjects.find((subject) => subject.id === editingSubjectId).concepts : 0, tasks: editingSubjectId ? subjects.find((subject) => subject.id === editingSubjectId).tasks : 0 }; if (editingSubjectId) Object.assign(subjects.find((subject) => subject.id === editingSubjectId), value); else subjects.push(value); save(); render(); $('#subject-dialog').close(); });
      $('#export-btn').addEventListener('click', () => { const blob = new Blob([JSON.stringify({ subjects, items }, null, 2)], { type: 'application/json' }); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = 'appxwind-docs-content.json'; link.click(); URL.revokeObjectURL(link.href); });
      render();
